{
  "name": "primanext-e2e",
  "version": "1.0.0",
  "description": "PrimaNext E2E test framework — Playwright + TypeScript",
  "scripts": {
    "test:dev":    "TEST_ENV=dev playwright test",
    "test:stage":  "TEST_ENV=stage playwright test",
    "test:prod":   "TEST_ENV=prod playwright test",
    "test:ui":     "TEST_ENV=dev playwright test --ui",
    "test:debug":  "TEST_ENV=dev playwright test --debug",
    "report":      "playwright show-report",
    "allure:gen":  "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@faker-js/faker": "^9.0.0",
    "@types/node": "^22.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.6.0"
  }
}
